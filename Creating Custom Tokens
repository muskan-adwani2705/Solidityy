pragma solidity ^0.8.0;

contract MuskanCoins{
    address public owner;
    uint public totalSupply;
    mapping (address => uint) public  balances;
    string public name = "MuskanCoins";
    string public symbol = "MUS";

    constructor(){
        owner = msg.sender;
    }

    function mintToken(uint amount) public {
        require(owner == msg.sender);
        balances[owner] += amount;
        totalSupply += amount;
    }

    function sendTo(address to , uint value) public {
       require(owner == msg.sender);
       balances[to] += value;
       totalSupply += value;
    }

    function transfer(address to , uint value) public {
        uint existingBalances = balances[owner];
        require(existingBalances >= value);
        balances[msg.sender] -= value;
        balances[to] += value;

    }
}
